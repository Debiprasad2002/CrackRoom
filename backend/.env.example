# Copy to backend/.env for local development. Never commit the real .env.
# With nothing set except DJANGO_DEBUG=1, the API runs on SQLite and local file storage.

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated. Render's own hostname is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The public origin(s) of the frontend, which proxies /api to Django.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Postgres: Project Settings > Database > Connection string > "Session pooler"
# (IPv4-compatible, which Render's free tier needs). Leave empty to use SQLite.
DATABASE_URL=
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Cloudflare R2 for notes PDFs. Leave R2_BUCKET empty to store files on local disk.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# How long a signed PDF link stays valid.
R2_SIGNED_URL_SECONDS=300

RESOURCE_MAX_UPLOAD_MB=25

# Sign in with Google: the OAuth client ID from Google Cloud Console (public, not a secret).
GOOGLE_CLIENT_ID=

# Mentorship invites: a Desktop OAuth client from the CrackRoom Google Cloud project, used by
# `manage.py connect_google_calendar`. Keep the refresh token on the server only, not in this file.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Real-time rooms. Leave empty for one server process (the in-memory layer).
# Set a Redis URL (e.g. Upstash free tier) before running more than one process.
REDIS_URL=
# Where browsers open room sockets. Defaults to wss://<RENDER_EXTERNAL_HOSTNAME> on Render,
# otherwise the page's own origin (the Vite dev proxy forwards /ws).
DJANGO_WEBSOCKET_PUBLIC_URL=
